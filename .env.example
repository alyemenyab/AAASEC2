# OpenRouter key (starts with sk-or-...) — https://openrouter.ai/keys
# ChatOpenAI reads this variable; base_url is set in code.
OPENAI_API_KEY=sk-or-REPLACE_ME

# Tavily web search — free tier at https://tavily.com
TAVILY_API_KEY=tvly-REPLACE_ME

# Set to 1 to run fully offline with deterministic fakes (no keys needed)
# USE_FAKE=1
